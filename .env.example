MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
VOICE_MODEL_NAME=muse-voice-transcribe-1.0
SAM_MODEL_NAME=sam-3.1
IMAGE_MODEL_NAME=muse-image-1.0
# Nudges from an open-weights Meta model (Muse Spark Open / Muse Glimmer) on Modal, Baseten or Fireworks.
# NUDGE_ENGINE=open turns it on; if the call fails, nudges fall back to Muse Spark.
NUDGE_ENGINE=spark
OPEN_BASE_URL=
OPEN_API_KEY=
OPEN_MODEL=
# Baseten: OPEN_BASE_URL from its Quickstart, OPEN_MODEL=meta-models/muse-spark-open-1026
# OPEN_MAX_TOKENS=1000
# Most badge images the server will draw per day (default 20).
MAX_IMAGES_PER_DAY=20
# Most output tokens one badge image may use (default 2048). Lower it once the [usage] lines show the real cost.
IMAGE_MAX_OUTPUT_TOKENS=2048
# Optional: real emails for device confirmation. Without it, links print in the server terminal.
RESEND_API_KEY=
# Login with just an email (no code) is on for the demo. Set to true to ask for the emailed code on login too.
REQUIRE_LOGIN_CODE=false
# Sign-up code for demos: 123456 whenever RESEND_API_KEY is empty. Set DEMO_CODE=anything to change it, or empty to turn it off.
DEMO_CODE=
EMAIL_FROM=Nudgy <onboarding@resend.dev>

# Reminder limits (read by the app at build time; restart the dev server after changing)
VITE_MAX_OPEN_TASKS=30
VITE_PAGE_SIZE=10
